#!/bin/bash

# Constants for macOS Keychain Service and Account names
SERVICE_NAME="getjwttoken_service"
USERNAME_KEY="getjwttoken_username"
PASSWORD_KEY="getjwttoken_password"

# Function to save username and password securely in macOS Keychain
save_credentials() {
    local username password

    # Prompt for username and password securely
    if ! IFS= read -r -p "Enter your username: " username; then
        echo "Error: Could not read username." >&2
        return 1
    fi
    if ! IFS= read -r -s -p "Enter your password: " password; then
        echo >&2
        echo "Error: Could not read password." >&2
        return 1
    fi
    echo

    if [[ -z "$username" || -z "$password" ]]; then
        echo "Error: Username and password must not be empty." >&2
        return 1
    fi

    # Save username in the Keychain
    if ! security add-generic-password -U -s "$SERVICE_NAME" -a "$USERNAME_KEY" -w "$username"; then
        echo "Error: Could not save username to Keychain." >&2
        return 1
    fi
    
    # Save password in the Keychain
    if ! security add-generic-password -U -s "$SERVICE_NAME" -a "$PASSWORD_KEY" -w "$password"; then
        echo "Error: Username was saved, but password could not be saved to Keychain. Run --config again to complete configuration." >&2
        return 1
    fi

    echo "Credentials saved successfully."
}

# Function to retrieve credentials from macOS Keychain
get_credentials() {
    # Retrieve username from Keychain
    if ! username=$(security find-generic-password -s "$SERVICE_NAME" -a "$USERNAME_KEY" -w 2>/dev/null); then
        echo "Error: Could not retrieve username from Keychain. Run --config to set up credentials." >&2
        return 1
    fi

    # Retrieve password from Keychain
    if ! password=$(security find-generic-password -s "$SERVICE_NAME" -a "$PASSWORD_KEY" -w 2>/dev/null); then
        echo "Error: Could not retrieve password from Keychain. Run --config to set up credentials." >&2
        return 1
    fi

    # Check if credentials were found
    if [[ -z "$username" || -z "$password" ]]; then
        echo "Error: Credentials not found. Please run the script with -c or --config to set them up." >&2
        return 1
    fi
}

# Fetch a token and either print it or copy it to the clipboard.
make_request() {
    local username password response_with_status response http_status
    local output_mode="${1:-copy}"

    get_credentials || return 1

    # Make the curl request with the stored credentials
    if ! response_with_status=$(curl --silent --show-error -X POST \
        --connect-timeout 5 --max-time 15 \
        -H "Content-Type: application/x-www-form-urlencoded" \
        --data-urlencode "username=$username" \
        --data-urlencode "password=$password" \
        --data-urlencode "token=true" \
        --write-out $'\n%{http_code}' \
        https://apps.crengland.com/sso/v1/tickets); then
        echo "Error: Token request failed." >&2
        return 1
    fi

    http_status=${response_with_status##*$'\n'}
    if [[ "$http_status" != 2[0-9][0-9] ]]; then
        echo "Error: Token request returned HTTP $http_status." >&2
        return 1
    fi

    # Remove the status suffix and trailing newlines from the response.
    response=$(printf '%s' "${response_with_status%$'\n'*}")
    if [[ -z "$response" ]]; then
        echo "Error: Token request returned an empty response." >&2
        return 1
    fi

    if [[ "$output_mode" == "print" ]]; then
        printf '%s\n' "$response"
        return "$?"
    fi

    # Copy the response to the clipboard
    if ! printf '%s' "$response" | pbcopy; then
        echo "Error: Could not copy the response to the clipboard." >&2
        return 1
    fi

    echo "The response has been copied to the clipboard."
}

print_usage() {
    cat <<'USAGE'
Usage: getjwttoken [OPTION]

  (no option), --copy              Fetch a token and copy it to the clipboard
  -p, --print                      Print only the token to stdout
  -c, --config                     Save credentials in macOS Keychain
  --install-profile [NAME [FILE]]  Add an automatic token export to a profile
                                  Defaults: MY_TOKEN and ${ZDOTDIR:-$HOME}/.zshrc
  -h, --help                       Show this help

Examples:
  getjwttoken --print
  MY_TOKEN="$(getjwttoken --print)" && export MY_TOKEN
  getjwttoken --install-profile MY_TOKEN
  getjwttoken --install-profile MY_TOKEN "$HOME/.zshrc"

Profile setup stores a command, never the token. Each new interactive shell
fetches a fresh token; child scripts inherit it. Fetch again when it expires.
USAGE
}

install_profile() {
    local variable="$1" profile="$2"
    local start_marker end_marker script_directory script_path quoted_path block
    local has_start=0 has_end=0

    if [[ ! "$variable" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
        echo "Error: Invalid variable name '$variable'. Use letters, digits, and underscores, starting with a letter or underscore." >&2
        return 1
    fi
    case "$variable" in
        HOME|home|CODEX_HOME|PATH|path|SHELL|IFS|ENV|BASH_ENV|ZDOTDIR|USER|LOGNAME|PWD|OLDPWD|SHLVL|TMPDIR)
            echo "Error: '$variable' is a shell configuration variable. Choose a token variable such as MY_TOKEN." >&2
            return 1
            ;;
    esac

    start_marker="# >>> getjwttoken: $variable >>>"
    end_marker="# <<< getjwttoken: $variable <<<"
    if [[ -e "$profile" || -L "$profile" ]]; then
        if [[ ! -f "$profile" || ! -r "$profile" ]]; then
            echo "Error: Profile must be a readable regular file: $profile" >&2
            return 1
        fi
        grep -Fqx -- "$start_marker" "$profile" && has_start=1
        grep -Fqx -- "$end_marker" "$profile" && has_end=1
        if [[ "$has_start" == 1 && "$has_end" == 1 ]]; then
            echo "$variable is already configured in $profile."
            return 0
        elif [[ "$has_start" == 1 || "$has_end" == 1 ]]; then
            echo "Error: Incomplete getjwttoken block in $profile. Remove it before running setup again." >&2
            return 1
        fi
    fi

    # Pin the command used for setup so the profile uses this version of the tool.
    if ! script_directory=$(cd -P -- "$(dirname -- "$0")" && pwd); then
        echo "Error: Could not resolve the getjwttoken command path." >&2
        return 1
    fi
    script_path="$script_directory/$(basename -- "$0")"
    if [[ ! -x "$script_path" ]]; then
        echo "Error: The getjwttoken command must be executable before installing a profile export." >&2
        return 1
    fi
    printf -v quoted_path '%q' "$script_path"
    printf -v block '%s\nif %s="$(%s --print)"; then\n    export %s\nelse\n    unset %s\nfi\n%s\n' \
        "$start_marker" "$variable" "$quoted_path" "$variable" "$variable" "$end_marker"

    if ! printf '\n%s' "$block" >> "$profile"; then
        echo "Error: Could not update profile: $profile" >&2
        return 1
    fi
    echo "Added $variable to $profile. Open a new shell to load it."
}

main() {
    case "${1:-}" in
        --install-profile)
            if [[ "$#" -gt 3 ]]; then
                echo "Error: Expected --install-profile [NAME [FILE]]." >&2
                return 2
            fi
            install_profile "${2-MY_TOKEN}" "${3-${ZDOTDIR:-$HOME}/.zshrc}"
            ;;
        ''|--copy|-p|--print|-c|--config|-h|--help)
            if [[ "$#" -gt 1 ]]; then
                echo "Error: Options cannot be combined. Use --help for usage." >&2
                return 2
            fi
            case "${1:-}" in
                -c|--config) save_credentials ;;
                -p|--print) make_request print ;;
                -h|--help) print_usage ;;
                *) make_request copy ;;
            esac
            ;;
        *)
            echo "Error: Unknown option '$1'. Use --help for usage." >&2
            return 2
            ;;
    esac
}

main "$@"
